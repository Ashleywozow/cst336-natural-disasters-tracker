<%- include("partials/head", { title: "Edit Community Report" }) %>

<%- include("partials/nav") %>

<%
  const standardDisasterTypes = [
    "Earthquake",
    "Flood",
    "Fire",
    "Storm"
  ];

  const isOtherDisaster =
    !standardDisasterTypes.includes(report.disaster_type);
%>

<main>
  <h1>Edit Community Report</h1>

  <form method="POST" action="/report/edit">

    <input
      type="hidden"
      name="report_id"
      value="<%= report.report_id %>"
    >

    <label for="report_title">Report Title:</label>
    <input
      type="text"
      id="report_title"
      name="report_title"
      value="<%= report.report_title %>"
      required
    >
    <br>

    <label for="location">Location:</label>
    <input
      type="text"
      id="location"
      name="location"
      value="<%= report.location %>"
      required
    >
    <br>

    <label for="disaster_type">Disaster Type:</label>

    <select
      id="disaster_type"
      name="disaster_type"
      required
    >
      <option value="">Select a disaster type</option>

      <option
        value="Earthquake"
        <%= report.disaster_type === "Earthquake"
          ? "selected" : "" %>
      >
        Earthquake
      </option>

      <option
        value="Flood"
        <%= report.disaster_type === "Flood"
          ? "selected" : "" %>
      >
        Flood
      </option>

      <option
        value="Fire"
        <%= report.disaster_type === "Fire"
          ? "selected" : "" %>
      >
        Fire
      </option>

      <option
        value="Storm"
        <%= report.disaster_type === "Storm"
          ? "selected" : "" %>
      >
        Storm
      </option>

      <option
        value="Other"
        <%= isOtherDisaster ? "selected" : "" %>
      >
        Other
      </option>
    </select>
    <br>

    <div
      id="other_disaster_container"
      <%= isOtherDisaster ? "" : "hidden" %>
    >
      <label for="other_disaster_type">
        Enter Disaster Type:
      </label>

      <input
        type="text"
        id="other_disaster_type"
        name="other_disaster_type"
        value="<%= isOtherDisaster
          ? report.disaster_type
          : "" %>"
      >
    </div>
    <br>

    <fieldset>
      <legend>Severity:</legend>

      <input
        type="radio"
        id="severity_minor"
        name="severity"
        value="Minor"
        <%= report.severity === "Minor"
          ? "checked" : "" %>
        required
      >
      <label for="severity_minor">Minor</label>

      <input
        type="radio"
        id="severity_moderate"
        name="severity"
        value="Moderate"
        <%= report.severity === "Moderate"
          ? "checked" : "" %>
      >
      <label for="severity_moderate">Moderate</label>

      <input
        type="radio"
        id="severity_extreme"
        name="severity"
        value="Extreme"
        <%= report.severity === "Extreme"
          ? "checked" : "" %>
      >
      <label for="severity_extreme">Extreme</label>
    </fieldset>

    <fieldset>
      <legend>Status:</legend>

      <input
        type="radio"
        id="status_active"
        name="status"
        value="Active"
        <%= report.status === "Active"
          ? "checked" : "" %>
        required
      >
      <label for="status_active">Active</label>

      <input
        type="radio"
        id="status_improving"
        name="status"
        value="Improving"
        <%= report.status === "Improving"
          ? "checked" : "" %>
      >
      <label for="status_improving">Improving</label>

      <input
        type="radio"
        id="status_resolved"
        name="status"
        value="Resolved"
        <%= report.status === "Resolved"
          ? "checked" : "" %>
      >
      <label for="status_resolved">Resolved</label>
    </fieldset>

    <label for="description">Description:</label>

    <textarea
      id="description"
      name="description"
      required
    ><%= report.description %></textarea>
    <br>

    <label for="event_date">Event Date:</label>

    <input
      type="date"
      id="event_date"
      name="event_date"
      value="<%= report.event_date %>"
      required
    >
    <br>

    <button type="submit">Update Report</button>

    <a href="/reports">Cancel</a>

  </form>
</main>

<%- include("partials/footer") %>