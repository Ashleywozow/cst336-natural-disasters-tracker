<%- include("partials/head", {
  title: pageTitle
}) %>

<%- include("partials/nav") %>

<main class="home-main">

  <div class="home-layout">

    <div class="home-content">

      <section class="hero">
        <p class="hero-eyebrow">Your source for real-time earthquake data, natural events, community reports, and preparedness resources.</p>
        <h1 class="hero-title">Natural Disasters Tracker</h1>

        <svg class="hero-waveform" viewBox="0 0 320 24" aria-hidden="true">
          <polyline
            points="0,12 40,12 55,2 70,22 85,12 130,12 145,4 160,20 175,12 320,12"
            fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
          />
        </svg>

        <p class="hero-sub">
          View recent earthquakes, natural events, community reports,
          and preparedness information in one place.
        </p>
      </section>

      <section class="feature-grid" aria-label="Explore the tracker">

        <a href="/earthquakes" class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
              <circle cx="12" cy="12" r="9" />
              <path d="M4 12h3l2-5 3 10 2-7 2 4h4" />
            </svg>
          </span>
          <span class="feature-title">Earthquakes</span>
          <span class="feature-desc">View recent earthquakes from the USGS. Filter and save important events.</span>
        </a>

        <a href="/events" class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M7 18a4 4 0 1 1 1-7.9A5 5 0 0 1 18 12a3.5 3.5 0 0 1-1 6.9H7Z" />
            </svg>
          </span>
          <span class="feature-title">Natural Events</span>
          <span class="feature-desc">See real-time events from NASA EONET including storms, fires, and more.</span>
        </a>

        <a href="/reports" class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M6 3h9l4 4v14H6z" />
              <path d="M10 11h6M10 15h6" />
            </svg>
          </span>
          <span class="feature-title">Community Reports</span>
          <span class="feature-desc">Report and view disaster impacts in your area.</span>
        </a>

        <a href="/preparedness" class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
              <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3Z" />
            </svg>
          </span>
          <span class="feature-title">Preparedness</span>
          <span class="feature-desc">Access helpful tips and resources to stay prepared.</span>
        </a>

        <a href="/dashboard" class="feature-card">
          <span class="feature-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="8" height="8" rx="1" />
              <rect x="13" y="3" width="8" height="5" rx="1" />
              <rect x="13" y="10" width="8" height="11" rx="1" />
              <rect x="3" y="13" width="8" height="8" rx="1" />
            </svg>
          </span>
          <span class="feature-title">Your Dashboard</span>
          <span class="feature-desc">View your saved earthquakes, reports, and personalized updates.</span>
        </a>

      </section>

    </div>

    <aside class="home-sidebar" aria-label="Emergency information">

      <div class="sidebar-item">
        <span class="sidebar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M4 4h16v12H7l-3 3V4Z" />
          </svg>
        </span>
        <div>
          <p class="sidebar-title">Live Reports</p>
          <p class="sidebar-text">Get real-time updates and emergency information.</p>
        </div>
      </div>

      <div class="sidebar-item">
        <span class="sidebar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
            <path d="M5 4h4l2 5-2.5 1.5a12 12 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2C10 21 3 14 3 6a2 2 0 0 1 2-2Z" />
          </svg>
        </span>
        <div>
          <p class="sidebar-title">Emergency Contact</p>
          <p class="sidebar-text">National Weather Service<br><strong>1-800-733-2767</strong><br>weather.gov</p>
        </div>
      </div>

      <div class="sidebar-item">
        <span class="sidebar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="6" y="2" width="12" height="20" rx="2" />
            <path d="M11 18h2" />
          </svg>
        </span>
        <div>
          <p class="sidebar-title">Stay Informed</p>
          <p class="sidebar-text">Download the app for alerts and notifications.</p>
          <div class="store-badges">
            <span class="store-badge">App Store</span>
            <span class="store-badge">Google Play</span>
          </div>
        </div>
      </div>

      <div class="sidebar-item sidebar-tip">
        <span class="sidebar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4 12H2M22 12h-2M5 5l1.5 1.5M17.5 17.5 19 19M5 19l1.5-1.5M17.5 6.5 19 5" />
          </svg>
        </span>
        <div>
          <p class="sidebar-title">Tip</p>
          <p class="sidebar-text">Enable notifications to receive critical alerts.</p>
        </div>
      </div>

    </aside>

  </div>

  <section class="emergency-bar">
    <div class="emergency-item">
      <span class="emergency-icon" aria-hidden="true">!</span>
      <p><strong>Emergency Reminder</strong><br>In a life-threatening emergency, call 9-1-1 immediately.</p>
    </div>
    <div class="emergency-item">
      <span class="emergency-icon" aria-hidden="true">&#10003;</span>
      <p><strong>Be Prepared</strong><br>Have an emergency kit, make a plan, and stay informed.</p>
    </div>
    <div class="emergency-item">
      <span class="emergency-icon" aria-hidden="true">&#9825;</span>
      <p><strong>Community Strong</strong><br>Working together helps our communities recover and stay safe.</p>
    </div>
    <p class="emergency-tagline">Stay informed. Stay prepared. Stay safe.<br>Together, we can weather any storm.</p>
  </section>

</main>

<%- include("partials/footer") %>

