<%- include("partials/head", { title: "Earthquake Details" }) %>

<%- include("partials/nav") %>

<main>
    <h1>Earthquake Details</h1>

    <% if (errorMessage) { %>

        <p class="error-message"><%= errorMessage %></p>
        <a href="/earthquakes">Back to Earthquakes</a>

    <% } else { %>

        <section class="earthquake-card">
            <p><strong>Location:</strong> <%= earthquake.place %></p>
            <p><strong>Magnitude:</strong> <%= earthquake.magnitude %></p>
            <p><strong>Date:</strong> <%= earthquake.time %></p>
            <p><strong>Coordinates:</strong> <%= earthquake.latitude %>, <%= earthquake.longitude %></p>
            <p><a href="<%= earthquake.url %>" target="_blank">View Ofsficial USGS Source</a></p>

            <form action="/earthquake/save" method="POST">
                <input type="hidden" name="apiEventId" value="<%= earthquake.id %>">
                <input type="hidden" name="title" value="M <%= earthquake.magnitude %> - <%= earthquake.place %>">
                <input type="hidden" name="location" value="<%= earthquake.place %>">
                <input type="hidden" name="magnitude" value="<%= earthquake.magnitude %>">
                <input type="hidden" name="eventDate" value="<%= earthquake.isoTime %>">
                <input type="hidden" name="sourceUrl" value="<%= earthquake.url %>">

                <label for="personalNote">Personal Note (optional):</label>
                <textarea name="personalNote" id="personalNote"></textarea>

                <button type="submit">Save Earthquake</button>
        </form>
    </section>

    <% } %>
</main>

<%- include("partials/footer") %>