<%- include("partials/head", { title: "Recent Earthquakes" }) %>

<%- include("partials/nav") %>

<main class="earthquakes-page">
  <h1>Recent Earthquakes</h1>

  <form action="/earthquakes" method="GET" id="magnitudeFilterForm">
    <label for="minMagnitude">Minimum Magnitude:</label>

    <select name="minMagnitude" id="minMagnitude">
      <option value="" <% if (!minMagnitude) { %>selected<% } %>>
        All Magnitudes
      </option>

      <option value="2.5" <% if (minMagnitude === "2.5") { %>selected<% } %>>
        2.5+
      </option>

      <option value="4.5" <% if (minMagnitude === "4.5") { %>selected<% } %>>
        4.5+
      </option>

      <option value="6.0" <% if (minMagnitude === "6.0") { %>selected<% } %>>
        6.0+
      </option>
    </select>

    <button type="submit">Apply Filter</button>
  </form>

  <% if (errorMessage) { %>

    <p class="error-message"><%= errorMessage %></p>

  <% } else if (earthquakes.length === 0) { %>

    <p class="empty-state">No earthquakes found for this filter.</p>

  <% } else { %>

    <div class="earthquakes-list">
      <% for (let eq of earthquakes) { %>

        <a
          href="/earthquake/details?id=<%= eq.id %>"
          class="earthquake-card-link"
          aria-label="View earthquake details for <%= eq.place %>"
        >
          <div class="earthquake-card-content">
            <h2><%= eq.place %></h2>

            <div class="earthquake-meta">
              <p>
                <strong>Magnitude:</strong>
                <%= eq.magnitude %>
              </p>

              <p>
                <strong>Date:</strong>
                <%= eq.time %>
              </p>
            </div>

            <span class="earthquake-card-action">
              View earthquake details
              <span aria-hidden="true">→</span>
            </span>
          </div>
        </a>

      <% } %>
    </div>

  <% } %>
</main>

<%- include("partials/footer") %>
